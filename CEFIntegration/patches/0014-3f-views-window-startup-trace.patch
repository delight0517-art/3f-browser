+void ViewsWindowStartupTrace(const char* milestone) {
+  if (!std::getenv("THREEF_CEF_STARTUP_TRACE")) {
+    return;
+  }
+  std::fprintf(stderr, "[3FWIN] %s\n", milestone);
+  std::fflush(stderr);
+  const char* path = std::getenv("THREEF_CEF_STARTUP_LOG");
+  if (path && path[0] != '\0') {
+    if (FILE* file = std::fopen(path, "a")) {
+      std::fprintf(file, "WINDOW %s\n", milestone);
+      std::fclose(file);
+    }
+  }
+}
 
