diff --git a/tests/cefsimple/simple_handler.cc b/tests/cefsimple/simple_handler.cc
--- a/tests/cefsimple/simple_handler.cc
+++ b/tests/cefsimple/simple_handler.cc
@@ -8,0 +9 @@
