@@ -132,0 +134,8 @@
+void SimpleHandler::OnLoadEnd(CefRefPtr<CefBrowser> browser,
+                              CefRefPtr<CefFrame> frame,
+                              int httpStatusCode) {
+  CEF_REQUIRE_UI_THREAD();
+  std::fprintf(stderr, "CEF_LOAD_END main=%d status=%d url=%s\n",
+               frame->IsMain(), httpStatusCode, frame->GetURL().ToString().c_str());
+  std::fflush(stderr);
+}
